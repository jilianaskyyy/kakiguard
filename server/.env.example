# Copy this file to `.env` (same folder) and fill in what you need.

# Port for the API server
PORT=3001

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-something-long-and-random
DB_KEY=

# OPTIONAL: turns on Claude-written explanations in the user's language.
# Without it, the built-in rule engine still powers everything.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Seconds to wait for your main kaki before asking the rest of the family (use ~20 for a live demo)
ESCALATE_SECONDS=120
# Time zone used for quiet hours
APP_TZ=Asia/Singapore
