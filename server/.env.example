# Copy this file to `.env` (same folder) and fill in what you need.

# Port for the API server
PORT=3001

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-something-long-and-random
DB_KEY=

# Get a free API key at https://aistudio.google.com
# Click the key icon at the bottom left of the page 'Get API Key'
# yoou can name it 'kakiguard' for easy reference and click 'create project'. 
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Seconds to wait for your main kaki before asking the rest of the family (use ~20 for a live demo)
ESCALATE_SECONDS=120
# Time zone used for quiet hours
APP_TZ=Asia/Singapore
